{
  "name": "omni",
  "version": "0.2.0",
  "private": true,
  "description": "Omni — Jarvis-class personal AI agent for your phone (OpenClaw runtime)",
  "scripts": {
    "mobile": "npm --prefix mobile start",
    "ios": "npm --prefix mobile run ios",
    "ios:prebuild": "npm --prefix mobile run prebuild:ios",
    "eas:ios": "npm --prefix mobile run eas:build:ios",
    "openclaw": "bash openclaw/up.sh",
    "openclaw:logs": "docker compose -f openclaw/docker-compose.yml logs -f openclaw-gateway",
    "server": "npm --prefix server dev",
    "server:start": "npm --prefix server start",
    "typecheck": "npm --prefix server typecheck && npm --prefix mobile run typecheck"
  }
}
