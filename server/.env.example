# Pick one provider (or set both; provider can be chosen per request)
XAI_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Defaults
OMNI_PROVIDER=xai
OMNI_MODEL=grok-4.5
PORT=8787
WORKSPACE_ROOT=./workspace

# Optional shared secret for /chat, /sessions, /tools (Bearer or x-omni-token)
OMNI_SERVER_TOKEN=

# Shell policy: strict (default) | full
OMNI_SHELL_MODE=strict

# /chat guards
OMNI_MAX_BODY_BYTES=256000
OMNI_CHAT_RATE_LIMIT=30
OMNI_CHAT_RATE_WINDOW_MS=60000
