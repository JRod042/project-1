# Copy to openclaw/.env and fill in. Never commit .env.

# Official image (Docker Hub mirror). GHCR alternative:
# OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
OPENCLAW_IMAGE=openclaw/openclaw:latest

# Shared secret for Control UI / gateway auth (required for non-loopback)
OPENCLAW_GATEWAY_TOKEN=replace-with-long-random-token

# Bind: lan (reachable on private network) | loopback (SSH/Tailscale only)
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_GATEWAY_PORT=18789

# Disable Bonjour inside containers (default)
OPENCLAW_DISABLE_BONJOUR=1

# Host paths (defaults to ./data and ./workspace next to this compose file)
# OPENCLAW_CONFIG_DIR=./data
# OPENCLAW_WORKSPACE_DIR=./workspace

# Model providers — optional if you already linked xAI (or another provider)
# via `openclaw onboard` OAuth on the host. API keys still work for Docker-only hosts.
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

OPENCLAW_TZ=UTC
