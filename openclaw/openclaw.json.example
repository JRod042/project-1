{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "controlUi": {
      "enabled": true
    },
    "auth": {
      "mode": "token",
      "token": "replace-with-same-as-OPENCLAW_GATEWAY_TOKEN"
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "xai/grok-4.5"
      }
    }
  },
  "models": {
    "providers": {
      "xai": {
        "apiKey": "${XAI_API_KEY}"
      }
    }
  }
}
