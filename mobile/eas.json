{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "store",
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_ENV": "preview",
        "EXPO_USE_PRECOMPILED_MODULES": "0",
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true"
      }
    },
    "production": {
      "distribution": "store",
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_ENV": "production",
        "EXPO_USE_PRECOMPILED_MODULES": "0",
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true"
      }
    }
  },
  "submit": {
    "preview": {
      "extends": "production"
    },
    "production": {
      "ios": {
        "appleTeamId": "FY5H9V76QL",
        "bundleIdentifier": "com.jrod042.omni",
        "ascAppId": "6797235230"
      },
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      }
    }
  }
}
