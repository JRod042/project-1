{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "store",
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "env": {
        "APP_ENV": "preview",
        "EXPO_USE_PRECOMPILED_MODULES": "0"
      }
    },
    "production": {
      "distribution": "store",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "APP_ENV": "production",
        "EXPO_USE_PRECOMPILED_MODULES": "0"
      }
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "bundleIdentifier": "com.jrod042.omni"
      }
    },
    "production": {
      "ios": {
        "bundleIdentifier": "com.jrod042.omni"
      }
    }
  }
}
