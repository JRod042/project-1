{
  "name": "omni-mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "ios": "expo run:ios",
    "ios:sim": "expo run:ios --device",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "android": "expo run:android",
    "web": "expo start --web",
    "eas:build:ios": "eas build --platform ios --profile development",
    "eas:build:ios:preview": "eas build --platform ios --profile preview",
    "eas:build:ios:prod": "eas build --platform ios --profile production",
    "eas:submit:ios": "eas submit --platform ios --profile production",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/syne": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.9",
    "expo-build-properties": "~57.0.1",
    "expo-constants": "~57.0.8",
    "expo-dev-client": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eas-cli": "^21.4.0",
    "typescript": "~6.0.3"
  }
}
